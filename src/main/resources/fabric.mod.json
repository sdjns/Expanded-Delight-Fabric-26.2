{
  "schemaVersion": 1,
  "id": "expandeddelight",
  "version": "${version}",
  "name": "Expanded Delight",
  "description": "A Farmer's Delight addon adding new crops, food and a juicer. Fabric 26.2 port.",
  "authors": [
    "ianm1647"
  ],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/FabricMC/fabric-example-mod"
  },
  "license": "CC0-1.0",
  "icon": "assets/expandeddelight/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "ianm1647.expandeddelight.ExpandedDelight"
    ],
    "client": [
      "ianm1647.expandeddelight.client.ExpandedDelightClient"
    ],
    "fabric-datagen": [
      "ianm1647.expandeddelight.data.EDDataGenerators"
    ]
  },
  "mixins": [
    "expandeddelight.mixins.json"
  ],
  "accessWidener": "expandeddelight.accesswidener",
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*",
    "farmersdelight": "*"
  }
